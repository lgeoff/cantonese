    {"hk": "香港", "jp": "hoeng1 gong2", "en": "Hong Kong", "fr": "Hong Kong",
     "note": "Literally 'fragrant harbour'. 香港人 = a Hongkonger.",
     "ex": {"en": "I was born in Hong Kong.", "parts": [["我","ngo5"],["喺","hai2"],["香港","hoeng1 gong2"],["出世","ceot1 sai3"],["。"]]}},
