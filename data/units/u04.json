  "grammar": [
    {
      "title": "係 (hai6) + place + 人 (jan4) = nationality",
      "explain": "Add 人 (jan4) after a place to say where someone is from: 香港人 (hoeng1 gong2 jan4), 瑞士人 (seoi6 si6 jan4), 法國人 (faat3 gwok3 jan4). To ask, put 邊度 (bin1 dou6) in the place slot: 你係邊度人啊 (nei5 hai6 bin1 dou6 jan4 aa3)？",
      "examples": [
        {
          "en": "Where are you from?",
          "parts": [
            [
              "你",
              "nei5"
            ],
            [
              "係",
              "hai6"
            ],
            [
              "邊度",
              "bin1 dou6"
            ],
            [
