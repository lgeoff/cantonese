    {"hk": "少少", "jp": "siu2 siu2", "en": "a little", "fr": "un peu",
     "ex": {"en": "I speak a little Cantonese.", "parts": [["我","ngo5"],["識講","sik1 gong2"],["少少","siu2 siu2"],["廣東話","gwong2 dung1 waa2"],["。"]]}},
    {"hk": "名", "jp": "meng2", "en": "name", "fr": "nom / prénom",
     "note": "In speech 名 is meng2: 你叫咩名啊？ (What's your name?). The formal word 名字 is ming4 zi6.",
     "ex": {"en": "What's your name?", "parts": [["你","nei5"],["叫","giu3"],["咩","me1"],["名","meng2"],["啊","aa3"],["？"]]}},
    {"hk": "歲", "jp": "seoi3", "en": "years old", "fr": "ans (âge)",
