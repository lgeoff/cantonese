     "ex": {"en": "Can you speak Cantonese?", "parts": [["你","nei5"],["識唔識","sik1 m4 sik1"],["講","gong2"],["廣東話","gwong2 dung1 waa2"],["啊","aa3"],["？"]]}},
    {"hk": "英文", "jp": "jing1 man2", "en": "English (language)", "fr": "anglais",
