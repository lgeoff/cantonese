     "ex": {"en": "Is your big brother married?", "parts": [["你","nei5"],["哥哥","go4 go1"],["結咗婚","git3 zo2 fan1"],["未","mei6"],["啊","aa3"],["？"]]}}
  ],
  "sentences": [
    {"en": "I'm from Hong Kong. And you?", "parts": [["我","ngo5"],["係","hai6"],["香港人","hoeng1 gong2 jan4"],["，"],["你","nei5"],["呢","ne1"],["？"]]},
    {"en": "I'm a New Zealander, but I was born in Hong Kong.", "parts": [["我","ngo5"],["係","hai6"],["新西蘭人","san1 sai1 laan4 jan4"],["，"],["不過","bat1 gwo3"],["喺","hai2"],["香港","hoeng1 gong2"],["出世","ceot1 sai3"],["。"]]},
    {"en": "We now live in Switzerland.", "parts": [["我哋","ngo5 dei6"],["而家","ji4 gaa1"],["住","zyu6"],["喺","hai2"],["瑞士","seoi6 si6"],["。"]]},
    {"en": "I can speak a little Cantonese.", "parts": [["我","ngo5"],["識","sik1"],["講","gong2"],["少少","siu2 siu2"],["廣東話","gwong2 dung1 waa2"],["。"]]},
    {"en": "Can she speak English?", "parts": [["佢","keoi5"],["識唔識","sik1 m4 sik1"],["講","gong2"],["英文","jing1 man2"],["啊","aa3"],["？"]]},
    {"en": "My little brother can't speak French.", "parts": [["我","ngo5"],["細佬","sai3 lou2"],["唔識","m4 sik1"],["講","gong2"],["法文","faat3 man2"],["。"]]},
    {"en": "Are they Chinese?", "parts": [["佢哋","keoi5 dei6"],["係唔係","hai6 m4 hai6"],["中國人","zung1 gwok3 jan4"],["啊","aa3"],["？"]]},
    {"en": "No, they're Swiss.", "parts": [["唔係","m4 hai6"],["，"],["佢哋","keoi5 dei6"],["係","hai6"],["瑞士人","seoi6 si6 jan4"],["。"]]},
