    {"hk": "我哋", "jp": "ngo5 dei6", "en": "we / us", "fr": "nous",
     "ex": {"en": "We live in Geneva.", "parts": [["我哋","ngo5 dei6"],["住","zyu6"],["喺","hai2"],["日內瓦","jat6 noi6 ngaa5"],["。"]]}},
    {"hk": "你哋", "jp": "nei5 dei6", "en": "you (plural)", "fr": "vous (pluriel)",
     "ex": {"en": "Are you (all) French?", "parts": [["你哋","nei5 dei6"],["係唔係","hai6 m4 hai6"],["法國人","faat3 gwok3 jan4"],["啊","aa3"],["？"]]}},
    {"hk": "佢哋", "jp": "keoi5 dei6", "en": "they / them", "fr": "ils / elles / eux",
