  "grammar": [
    {"title": "係 + place + 人 = nationality",
     "explain": "Add 人 jan4 (person) after a place to say where someone is from: 香港人, 瑞士人, 法國人. To ask, put 邊度 in the place slot: 你係邊度人啊？",
     "examples": [
       {"en": "Where are you from?", "parts": [["你","nei5"],["係","hai6"],["邊度人","bin1 dou6 jan4"],["啊","aa3"],["？"]]},
       {"en": "I'm French.", "parts": [["我","ngo5"],["係","hai6"],["法國人","faat3 gwok3 jan4"],["。"]]}
     ]},
    {"title": "哋 makes pronouns plural",
     "explain": "我 → 我哋 (we), 你 → 你哋 (you all), 佢 → 佢哋 (they). Only pronouns take 哋, not nouns.",
     "examples": [
       {"en": "We are New Zealanders.", "parts": [["我哋","ngo5 dei6"],["係","hai6"],["新西蘭人","san1 sai1 laan4 jan4"],["。"]]},
       {"en": "Do they live in Hong Kong?", "parts": [["佢哋","keoi5 dei6"],["係唔係","hai6 m4 hai6"],["住","zyu6"],["喺","hai2"],["香港","hoeng1 gong2"],["啊","aa3"],["？"]]}
     ]},
    {"title": "住喺 = live in",
     "explain": "喺 hai2 means 'at / in'. Put it between the verb and the place: 住喺日內瓦. Don't confuse it with 係 hai6 (to be).",
     "examples": [
       {"en": "He lives in France.", "parts": [["佢","keoi5"],["住","zyu6"],["喺","hai2"],["法國","faat3 gwok3"],["。"]]},
       {"en": "He is French.", "parts": [["佢","keoi5"],["係","hai6"],["法國人","faat3 gwok3 jan4"],["。"]]}
     ]}
  ],
  "dialogue": {
    "title": "A new neighbour in Geneva",
    "lines": [
      {"spk": "A", "en": "Hello! Did you just move in?", "parts": [["你好","nei5 hou2"],["！"],["你","nei5"],["新","san1"],["搬嚟","bun1 lai4"],["㗎","gaa3"],["？"]]},
      {"spk": "B", "en": "Yes, my name's Mark. I live on the third floor.", "parts": [["係","hai6"],["啊","aa3"],["，"],["我","ngo5"],["叫","giu3"],["馬克","maa5 hak1"],["，"],["住","zyu6"],["三樓","saam1 lau2"],["。"]]},
      {"spk": "A", "en": "I'm Yan, from the fifth floor. Oh, you speak Cantonese?", "parts": [["我","ngo5"],["叫","giu3"],["阿欣","aa3 jan1"],["，"],["住","zyu6"],["五樓","ng5 lau2"],["。"],["咦","ji2"],["，"],["你","nei5"],["識","sik1"],["講","gong2"],["廣東話","gwong2 dung1 waa2"],["㗎","gaa3"],["？"]]},
      {"spk": "B", "en": "Just a little. I was born in Hong Kong.", "parts": [["少少","siu2 siu2"],["啫","ze1"],["。"],["我","ngo5"],["喺","hai2"],["香港","hoeng1 gong2"],["出世","ceot1 sai3"],["。"]]},
      {"spk": "A", "en": "So you're a Hongkonger?", "parts": [["噉","gam2"],["你","nei5"],["係","hai6"],["香港人","hoeng1 gong2 jan4"],["？"]]},
      {"spk": "B", "en": "I'm a New Zealander, but my family are all Hongkongers.", "parts": [["我","ngo5"],["係","hai6"],["新西蘭人","san1 sai1 laan4 jan4"],["，"],["不過","bat1 gwo3"],["我","ngo5"],["屋企人","uk1 kei2 jan4"],["都係","dou1 hai6"],["香港人","hoeng1 gong2 jan4"],["。"]]},
      {"spk": "A", "en": "Wow, you speak really well!", "parts": [["嘩","waa1"],["，"],["你","nei5"],["講得","gong2 dak1"],["好好","hou2 hou2"],["啊","aa3"],["！"]]},
      {"spk": "B", "en": "Thanks! Do you speak French?", "parts": [["多謝","do1 ze6"],["！"],["你","nei5"],["識唔識","sik1 m4 sik1"],["講","gong2"],["法文","faat3 man2"],["啊","aa3"],["？"]]},
      {"spk": "A", "en": "Not a word! Come up for a cup of tea when you're free!", "parts": [["一句","jat1 geoi3"],["都","dou1"],["唔識","m4 sik1"],["！"],["得閒","dak1 haan4"],["上嚟","soeng5 lai4"],["飲杯茶","jam2 bui1 caa4"],["啦","laa1"],["！"]]},
      {"spk": "B", "en": "Sure, thanks! Bye!", "parts": [["好","hou2"],["啊","aa3"],["，"],["多謝","do1 ze6"],["！"],["拜拜","baai1 baai3"],["！"]]}
    ],
    "questions": [
      {"q": "Which floor does Mark live on?", "options": ["The third floor", "The fifth floor", "The first floor", "The tenth floor"], "answer": 0},
      {"q": "Where was Mark born?", "options": ["Hong Kong", "New Zealand", "Geneva", "France"], "answer": 0},
      {"q": "What nationality is Mark?", "options": ["New Zealander", "Hongkonger", "Swiss", "French"], "answer": 0},
      {"q": "Does Yan speak French?", "options": ["No, not at all", "Yes, very well", "A little", "She's learning it"], "answer": 0}
    ]
  }
