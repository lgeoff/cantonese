  "desc": "Say who you are, where you're from, where you live and what languages you speak",
  "words": [
    {"hk": "我", "jp": "ngo5", "en": "I / me", "fr": "je / moi",
     "note": "Many Hongkongers drop the ng-: 'o5'. Both are fine.",
