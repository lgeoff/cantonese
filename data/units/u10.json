  "grammar": [
    {"title": "呢 / 嗰 + classifier + noun",
     "explain": "'This' and 'that' need a classifier between them and the noun: 呢件衫 (this top), 嗰條褲 (those trousers), 呢對鞋 (this pair of shoes). For plurals use 啲: 呢啲衫 (these clothes).",
     "examples": [
       {"en": "This top is very pretty.", "parts": [["呢件","nei1 gin6"],["衫","saam1"],["好","hou2"],["靚","leng3"],["。"]]},
       {"en": "That pair of shoes is cheap.", "parts": [["嗰對","go2 deoi3"],["鞋","haai4"],["好","hou2"],["平","peng4"],["。"]]},
       {"en": "How much are these?", "parts": [["呢啲","ni1 di1"],["點","dim2"],["賣","maai6"],["啊","aa3"],["？"]]}
     ]},
    {"title": "Adjective + 啲 = a bit more",
     "explain": "Put 啲 after an adjective to mean '-er / a bit more': 平啲 cheaper, 大啲 bigger, 細啲 smaller. Very handy when bargaining.",
     "examples": [
       {"en": "Do you have a smaller one?", "parts": [["有冇","jau5 mou5"],["細啲","sai3 di1"],["嘅","ge3"],["啊","aa3"],["？"]]},
       {"en": "Cheaper, come on!", "parts": [["平啲","peng4 di1"],["啦","laa1"],["！"]]}
     ]},
    {"title": "有冇…? and the A-not-A question",
     "explain": "有冇 + thing asks 'do you have / is there'. Any verb or adjective can be doubled with 唔 to ask yes/no: 收唔收 (do you accept?), 夠唔夠 (enough?).",
     "examples": [
       {"en": "Is there a supermarket nearby?", "parts": [["附近","fu6 gan6"],["有冇","jau5 mou5"],["超市","ciu1 si5"],["啊","aa3"],["？"]]},
       {"en": "Do you take cards?", "parts": [["收唔收","sau1 m4 sau1"],["卡","kaat1"],["啊","aa3"],["？"]]}
     ]}
  ],
