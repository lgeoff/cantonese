  "sentences": [
    {"en": "Excuse me, how do I get to Central?", "parts": [["請問","ceng2 man6"],["中環","zung1 waan4"],["點","dim2"],["去","heoi3"],["啊","aa3"],["？"]]},
    {"en": "Go straight, and turn left at the second junction.", "parts": [["一直行","jat1 zik6 haang4"],["，"],["第二個","dai6 ji6 go3"],["路口","lou6 hau2"],["轉","zyun3"],["左","zo2"],["。"]]},
    {"en": "The MTR station is close, it's only a five-minute walk.", "parts": [["地鐵站","dei6 tit3 zaam6"],["好","hou2"],["近","kan5"],["，"],["行","haang4"],["五分鐘","ng5 fan1 zung1"],["咋","zaa3"],["。"]]},
    {"en": "It takes about forty minutes by bus.", "parts": [["搭","daap3"],["巴士","baa1 si2"],["大概","daai6 koi3"],["要","jiu3"],["四十分鐘","sei3 sap6 fan1 zung1"],["。"]]},
    {"en": "Is Tsim Sha Tsui far from here?", "parts": [["呢度","ni1 dou6"],["去","heoi3"],["尖沙咀","zim1 saa1 zeoi2"],["遠唔遠","jyun5 m4 jyun5"],["啊","aa3"],["？"]]},
    {"en": "Where are you? I'm at the bus stop.", "parts": [["你","nei5"],["喺","hai2"],["邊度","bin1 dou6"],["啊","aa3"],["？"],["我","ngo5"],["喺","hai2"],["巴士站","baa1 si2 zaam6"],["。"]]},
    {"en": "To the airport, please. (to a taxi driver)", "parts": [["唔該","m4 goi1"],["，"],["去","heoi3"],["機場","gei1 coeng4"],["。"]]},
    {"en": "I walk home every day.", "parts": [["我","ngo5"],["每日","mui5 jat6"],["行路","haang4 lou6"],["返","faan1"],["屋企","uk1 kei2"],["。"]]},
    {"en": "Do I need to change trains?", "parts": [["使唔使","sai2 m4 sai2"],["轉車","zyun3 ce1"],["啊","aa3"],["？"]]},
    {"en": "The airport isn't far, it's about half an hour.", "parts": [["機場","gei1 coeng4"],["唔係","m4 hai6"],["好","hou2"],["遠","jyun5"],["，"],["半個鐘","bun3 go3 zung1"],["左右","zo2 jau2"],["。"]]},
    {"en": "When does your plane arrive?", "parts": [["你","nei5"],["班","baan1"],["飛機","fei1 gei1"],["幾點","gei2 dim2"],["到","dou3"],["啊","aa3"],["？"]]},
    {"en": "We take the minibus to go up the hill.", "parts": [["我哋","ngo5 dei6"],["搭","daap3"],["小巴","siu2 baa1"],["上山","soeng5 saan1"],["。"]]},
    {"en": "Come to my place on Saturday!", "parts": [["星期六","sing1 kei4 luk6"],["嚟","lai4"],["我","ngo5"],["屋企","uk1 kei2"],["啦","laa1"],["！"]]}
  ],
  "grammar": [
    {"title": "No 'to': just verb + place",
     "explain": "去, 嚟 and 返 take the place directly, with no word for 'to'. To say how you travel, put 搭 + transport before it.",
     "examples": [
       {"en": "I'm going to Central.", "parts": [["我","ngo5"],["去","heoi3"],["中環","zung1 waan4"],["。"]]},
       {"en": "I take the MTR to the airport.", "parts": [["我","ngo5"],["搭","daap3"],["地鐵","dei6 tit3"],["去","heoi3"],["機場","gei1 coeng4"],["。"]]},
       {"en": "He takes a taxi home.", "parts": [["佢","keoi5"],["搭","daap3"],["的士","dik1 si2"],["返","faan1"],["屋企","uk1 kei2"],["。"]]}
     ]},
    {"title": "喺 + place comes before the action",
     "explain": "'Where' something happens goes before the verb, not at the end like in English: 'I at Central work', not 'I work at Central'.",
     "examples": [
       {"en": "I work in Central.", "parts": [["我","ngo5"],["喺","hai2"],["中環","zung1 waan4"],["做嘢","zou6 je5"],["。"]]},
       {"en": "Let's wait at the exit.", "parts": [["我哋","ngo5 dei6"],["喺","hai2"],["出口","ceot1 hau2"],["等","dang2"],["啦","laa1"],["。"]]}
     ]},
    {"title": "How long? 要幾耐",
     "explain": "Ask 'how long does it take' with 要幾耐. Answer with 要 + duration; add 左右 or 大概 for 'about'.",
     "examples": [
       {"en": "How long does it take to walk there?", "parts": [["行路","haang4 lou6"],["去","heoi3"],["要","jiu3"],["幾耐","gei2 noi6"],["啊","aa3"],["？"]]},
       {"en": "About ten minutes.", "parts": [["大概","daai6 koi3"],["十分鐘","sap6 fan1 zung1"],["。"]]}
     ]}
  ],
  "dialogue": {
    "title": "Asking the way to the MTR",
    "lines": [
      {"spk": "A", "en": "Excuse me, how do I get to the MTR station?", "parts": [["唔好意思","m4 hou2 ji3 si1"],["，"],["請問","ceng2 man6"],["地鐵站","dei6 tit3 zaam6"],["點","dim2"],["去","heoi3"],["啊","aa3"],["？"]]},
      {"spk": "B", "en": "Go straight, and turn right at the second junction.", "parts": [["一直行","jat1 zik6 haang4"],["，"],["第二個","dai6 ji6 go3"],["路口","lou6 hau2"],["轉","zyun3"],["右","jau6"],["。"]]},
      {"spk": "A", "en": "Is it far?", "parts": [["遠唔遠","jyun5 m4 jyun5"],["啊","aa3"],["？"]]},
      {"spk": "B", "en": "Not far, about five minutes on foot.", "parts": [["唔遠","m4 jyun5"],["，"],["行","haang4"],["五分鐘","ng5 fan1 zung1"],["左右","zo2 jau2"],["。"]]},
      {"spk": "A", "en": "Actually I'm going to the airport. What should I take?", "parts": [["其實","kei4 sat6"],["我","ngo5"],["要","jiu3"],["去","heoi3"],["機場","gei1 coeng4"],["，"],["搭","daap3"],["咩","me1"],["車","ce1"],["好","hou2"],["啊","aa3"],["？"]]},
      {"spk": "B", "en": "Take the airport bus, it's very convenient. The stop is just over there on the left.", "parts": [["搭","daap3"],["機場","gei1 coeng4"],["巴士","baa1 si2"],["啦","laa1"],["，"],["好","hou2"],["方便","fong1 bin6"],["，"],["個","go3"],["站","zaam6"],["喺","hai2"],["左邊","zo2 bin1"],["。"]]},
      {"spk": "A", "en": "How long does it take?", "parts": [["要","jiu3"],["幾耐","gei2 noi6"],["啊","aa3"],["？"]]},
      {"spk": "B", "en": "About an hour.", "parts": [["大概","daai6 koi3"],["一個鐘","jat1 go3 zung1"],["。"]]},
      {"spk": "A", "en": "Thanks so much!", "parts": [["唔該晒","m4 goi1 saai3"],["！"]]},
      {"spk": "B", "en": "No problem.", "parts": [["唔使","m4 sai2"],["唔該","m4 goi1"],["。"]]}
    ],
    "questions": [
