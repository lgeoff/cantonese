  "grammar": [
    {"title": "Time goes before the verb",
     "explain": "When something happens (每日, 七點, 星期六) comes before the verb, either right after the subject or at the very start.",
     "examples": [
       {"en": "I get up at seven.", "parts": [["我","ngo5"],["七點","cat1 dim2"],["起身","hei2 san1"],["。"]]},
       {"en": "Every day I go to work by bus.", "parts": [["每日","mui5 jat6"],["我","ngo5"],["搭","daap3"],["巴士","baa1 si2"],["返工","faan1 gung1"],["。"]]}
     ]},
    {"title": "Ordering actions: 先…再…, 然後, 之後",
     "explain": "先 A 再 B = first A, then B (often an instruction). 然後 links a list of steps. X 之後 = after X; use Verb + 完 + 之後 for 'after finishing'.",
     "examples": [
       {"en": "Wash your hands first, then eat.", "parts": [["你","nei5"],["先","sin1"],["洗手","sai2 sau2"],["，"],["再","zoi3"],["食飯","sik6 faan6"],["。"]]},
       {"en": "I get up, then brush my teeth, then shower.", "parts": [["我","ngo5"],["起身","hei2 san1"],["，"],["刷牙","caat3 ngaa4"],["，"],["然後","jin4 hau6"],["沖涼","cung1 loeng4"],["。"]]},
       {"en": "After eating I watch TV.", "parts": [["食完飯","sik6 jyun4 faan6"],["之後","zi1 hau6"],["我","ngo5"],["睇電視","tai2 din6 si6"],["。"]]}
     ]},
    {"title": "Duration goes after the verb",
     "explain": "'For how long' comes after the verb: 瞓咗八個鐘 (slept for eight hours). Compare with clock time, which comes before.",
     "examples": [
       {"en": "I slept for eight hours.", "parts": [["我","ngo5"],["瞓咗","fan3 zo2"],["八個鐘","baat3 go3 zung1"],["。"]]},
       {"en": "He works ten hours a day.", "parts": [["佢","keoi5"],["每日","mui5 jat6"],["做","zou6"],["十個","sap6 go3"],["鐘頭","zung1 tau4"],["。"]]}
     ]}
  ],
