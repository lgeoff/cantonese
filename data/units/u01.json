  "grammar": [
    {
      "title": "Questions go where the answer goes",
      "explain": "Cantonese doesn't move question words to the front. Say the statement and drop 邊度 (bin1 dou6) / 咩 (me1) / 邊個 (bin1 go3) into the slot of the answer.",
      "examples": [
        {
          "en": "I want to go to your home.",
          "parts": [
            [
              "我",
              "ngo5"
            ],
            [
              "想",
              "soeng2"
            ],
            [
              "去",
              "heoi3"
            ],
            [
              "你",
              "nei5"
            ],
            [
              "屋企",
              "uk1 kei2"
            ],
            [
              "。"
            ]
          ]
        },
        {
          "en": "What do you want to eat?",
          "parts": [
            [
              "你",
              "nei5"
            ],
            [
              "想",
              "soeng2"
            ],
            [
