  "grammar": [
    {"title": "Questions go where the answer goes",
     "explain": "Cantonese doesn't move question words to the front. Say the statement and drop 邊度 / 咩 / 邊個 into the slot of the answer.",
     "examples": [
       {"en": "My home is in Geneva. → Where is your home?", "parts": [["我","ngo5"],["屋企","uk1 kei2"],["喺","hai2"],["日內瓦","jat6 noi6 ngaa5"],["。"]]},
       {"en": "Where is your home?", "parts": [["你","nei5"],["屋企","uk1 kei2"],["喺","hai2"],["邊度","bin1 dou6"],["？"]]}
     ]},
    {"title": "想 vs 想要",
     "explain": "想 + verb = want to do. 想要 + thing = want a thing.",
     "examples": [
       {"en": "I want to go shopping.", "parts": [["我","ngo5"],["想","soeng2"],["去","heoi3"],["買嘢","maai5 je5"],["。"]]},
       {"en": "I want a bicycle.", "parts": [["我","ngo5"],["想要","soeng2 jiu3"],["架","gaa3"],["單車","daan1 ce1"],["。"]]}
     ]}
  ],
  "dialogue": {
    "title": "At home on a rainy day",
    "lines": [
      {"spk": "A", "en": "What are you doing?", "parts": [["你","nei5"],["做緊","zou6 gan2"],["咩","me1"],["啊","aa3"],["？"]]},
      {"spk": "B", "en": "I'm watching TV.", "parts": [["我","ngo5"],["睇緊","tai2 gan2"],["電視","din6 si6"],["。"]]},
      {"spk": "A", "en": "Do you want to go running?", "parts": [["你","nei5"],["想唔想","soeng2 m4 soeng2"],["去","heoi3"],["跑步","paau2 bou6"],["啊","aa3"],["？"]]},
      {"spk": "B", "en": "It's raining. I don't want to.", "parts": [["落緊雨","lok6 gan2 jyu5"],["，"],["我","ngo5"],["唔想","m4 soeng2"],["。"]]},
      {"spk": "A", "en": "Then let's go shopping!", "parts": [["噉","gam2"],["我哋","ngo5 dei6"],["去","heoi3"],["買嘢","maai5 je5"],["啦","laa1"],["！"]]},
      {"spk": "B", "en": "OK! Where to?", "parts": [["好","hou2"],["啊","aa3"],["！"],["去","heoi3"],["邊度","bin1 dou6"],["啊","aa3"],["？"]]}
    ],
    "questions": [
      {"q": "What is B doing at first?", "options": ["Watching TV", "Sleeping", "Running", "Shopping"], "answer": 0},
      {"q": "Why doesn't B want to go running?", "options": ["It's raining", "It's too difficult", "B is sleeping", "B has no bike"], "answer": 0},
