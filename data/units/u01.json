              "sik6"
            ],
            [
              "咩",
              "me1"
            ],
            [
              "啊",
              "aa3"
            ],
            [
              "？"
            ]
          ]
        },
        {
          "en": "Who is he?",
          "parts": [
            [
              "佢",
              "keoi5"
