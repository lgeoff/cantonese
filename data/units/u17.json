    {"en": "I worked overtime until eleven last night, I'm exhausted.", "parts": [["我","ngo5"],["尋晚","cam4 maan5"],["加班","gaa1 baan1"],["加","gaa1"],["到","dou3"],["十一點","sap6 jat1 dim2"],["，"],["好","hou2"],["攰","gui6"],["。"]]},
