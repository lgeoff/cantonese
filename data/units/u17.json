  "sentences": [
    {"en": "I'm so busy at work that I don't even have time for lunch.", "parts": [["我","ngo5"],["返工","faan1 gung1"],["忙","mong4"],["到","dou3"],["連","lin4"],["食晏","sik6 aan3"],["都","dou1"],["冇","mou5"],["時間","si4 gaan3"],["。"]]},
    {"en": "The boss is in a meeting, come back in an hour.", "parts": [["老闆","lou5 baan2"],["開緊會","hoi1 gan2 wui2"],["，"],["你","nei5"],["一個","jat1 go3"],["鐘頭","zung1 tau4"],["之後","zi1 hau6"],["再","zoi3"],["嚟","lai4"],["啦","laa1"],["。"]]},
