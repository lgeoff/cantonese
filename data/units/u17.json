  "grammar": [
    {"title": "Verb + 到 + result = so … that",
     "explain": "Put 到 after an adjective or verb, then say the result: 忙到冇時間食飯 'so busy I have no time to eat'.",
     "examples": [
       {"en": "I'm so tired I can't open my eyes.", "parts": [["我","ngo5"],["攰","gui6"],["到","dou3"],["擘唔開","maak3 m4 hoi1"],["眼","ngaan5"],["。"]]},
       {"en": "He was so happy he jumped up.", "parts": [["佢","keoi5"],["開心","hoi1 sam1"],["到","dou3"],["跳","tiu3"],["起","hei2"],["嚟","lai4"],["。"]]}
     ]},
    {"title": "Splitting verb + object: 辭咗職, 讀過書",
     "explain": "Many two-character verbs are really verb + object (辭職, 讀書, 開會, 搵工). Aspect markers and durations go in the middle: 開緊會, 辭咗職, 搵咗三個月工.",
     "examples": [
       {"en": "She's in a meeting.", "parts": [["佢","keoi5"],["開緊會","hoi1 gan2 wui2"],["。"]]},
       {"en": "I studied for four years at university.", "parts": [["我","ngo5"],["讀","duk6"],["咗","zo2"],["四年","sei3 nin4"],["大學","daai6 hok6"],["。"]]}
     ]},
    {"title": "因為…所以… = because … so …",
     "explain": "Unlike English, Cantonese happily uses both halves together. You can also drop either one.",
     "examples": [
       {"en": "Because I have an exam, I'm not going out tonight.", "parts": [["因為","jan1 wai6"],["要","jiu3"],["考試","haau2 si3"],["，"],["所以","so2 ji5"],["我","ngo5"],["今晚","gam1 maan5"],["唔","m4"],["出去","ceot1 heoi3"],["。"]]},
       {"en": "Why did you quit? — Because the pay was too low.", "parts": [["點解","dim2 gaai2"],["辭職","ci4 zik1"],["啊","aa3"],["？"],["因為","jan1 wai6"],["人工","jan4 gung1"],["太","taai3"],["低","dai1"],["。"]]}
     ]}
  ],
  "dialogue": {
    "title": "The job interview",
    "lines": [
      {"spk": "A", "en": "Please have a seat. Could you introduce yourself first?", "parts": [["請坐","ceng2 co5"],["。"],["你","nei5"],["可唔可以","ho2 m4 ho2 ji5"],["先","sin1"],["介紹","gaai3 siu6"],["下","haa5"],["自己","zi6 gei2"],["啊","aa3"],["？"]]},
      {"spk": "B", "en": "Sure. I'm Wing, I studied design at university.", "parts": [["好","hou2"],["。"],["我","ngo5"],["叫","giu3"],["阿詠","aa3 wing6"],["，"],["大學","daai6 hok6"],["讀","duk6"],["設計","cit3 gai3"],["。"]]},
      {"spk": "A", "en": "Do you have any work experience?", "parts": [["你","nei5"],["有冇","jau5 mou5"],["工作","gung1 zok3"],["經驗","ging1 jim6"],["啊","aa3"],["？"]]},
      {"spk": "B", "en": "I worked at an advertising company for three years.", "parts": [["我","ngo5"],["喺","hai2"],["一間","jat1 gaan1"],["廣告","gwong2 gou3"],["公司","gung1 si1"],["做","zou6"],["咗","zo2"],["三年","saam1 nin4"],["。"]]},
      {"spk": "A", "en": "Then why do you want to change jobs?", "parts": [["噉","gam2"],["點解","dim2 gaai2"],["想","soeng2"],["轉工","zyun3 gung1"],["呢","ne1"],["？"]]},
      {"spk": "B", "en": "Over there I had to work overtime every day, till midnight — I want to learn new things.", "parts": [["嗰度","go2 dou6"],["日日","jat6 jat6"],["加班","gaa1 baan1"],["加","gaa1"],["到","dou3"],["半夜","bun3 je2"],["，"],["我","ngo5"],["想","soeng2"],["學","hok6"],["啲","di1"],["新","san1"],["嘢","je5"],["。"]]},
      {"spk": "A", "en": "Ha, we're not that busy here. Do you have any questions?", "parts": [["哈哈","haa1 haa1"],["，"],["我哋","ngo5 dei6"],["呢度","ni1 dou6"],["冇","mou5"],["咁","gam3"],["忙","mong4"],["。"],["你","nei5"],["有冇","jau5 mou5"],["問題","man6 tai4"],["想","soeng2"],["問","man6"],["啊","aa3"],["？"]]},
      {"spk": "B", "en": "Um... about how much is the pay?", "parts": [["嗯","ng6"],["……"],["人工","jan4 gung1"],["大概","daai6 koi3"],["有","jau5"],["幾多","gei2 do1"],["呢","ne1"],["？"]]},
      {"spk": "A", "en": "Let's talk about pay in the second interview. We'll email you next week.", "parts": [["人工","jan4 gung1"],["我哋","ngo5 dei6"],["第二輪","dai6 ji6 leon4"],["面試","min6 si3"],["再","zoi3"],["傾","king1"],["啦","laa1"],["。"],["我哋","ngo5 dei6"],["下個","haa6 go3"],["禮拜","lai5 baai3"],["會","wui5"],["電郵","din6 jau4"],["通知","tung1 zi1"],["你","nei5"],["。"]]},
      {"spk": "B", "en": "Great, thank you very much!", "parts": [["好","hou2"],["啊","aa3"],["，"],["唔該晒","m4 goi1 saai3"],["！"]]}
    ],
    "questions": [
      {"q": "What did Wing study at university?", "options": ["Design", "Accounting", "English", "Marketing"], "answer": 0},
