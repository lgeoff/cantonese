  "grammar": [
    {"title": "有 / 冇 / 有冇",
     "explain": "有 = have / there is. The negative is 冇 (never 唔有). To ask, use 有冇: 你有冇車？ Answer 有 or 冇.",
     "examples": [
       {"en": "Do you have any brothers or sisters?", "parts": [["你","nei5"],["有冇","jau5 mou5"],["兄弟姊妹","hing1 dai6 zi2 mui6"],["啊","aa3"],["？"]]},
       {"en": "Yes, I have a big sister.", "parts": [["有","jau5"],["，"],["我","ngo5"],["有","jau5"],["一個","jat1 go3"],["家姐","gaa1 ze1"],["。"]]},
       {"en": "There's no one at home.", "parts": [["屋企","uk1 kei2"],["冇","mou5"],["人","jan4"],["。"]]}
     ]},
    {"title": "'My' without 嘅",
     "explain": "For family and close people, just put the pronoun in front: 我媽媽 (my mum), 你老公 (your husband). For 仔 and 女, add the measure word 個: 我個仔, 佢個女.",
     "examples": [
       {"en": "My mum", "parts": [["我","ngo5"],["媽媽","maa4 maa1"]]},
       {"en": "Her daughter", "parts": [["佢","keoi5"],["個","go3"],["女","neoi2"]]}
     ]},
    {"title": "…嚟㗎 to identify someone",
     "explain": "係 + noun + 嚟㗎 means 'is (actually) a…', used when explaining or correcting who/what something is. Very common in speech.",
     "examples": [
       {"en": "She's my grandma.", "parts": [["佢","keoi5"],["係","hai6"],["我","ngo5"],["嫲嫲","maa4 maa4"],["嚟","lai4"],["㗎","gaa3"],["。"]]},
       {"en": "Who's this?", "parts": [["呢個","ni1 go3"],["係","hai6"],["邊個","bin1 go3"],["嚟","lai4"],["㗎","gaa3"],["？"]]}
     ]}
  ],
