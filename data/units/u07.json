      {"spk": "A", "en": "So cute! Boys or girls?", "parts": [["好","hou2"],["得意","dak1 ji3"],["啊","aa3"],["！"],["男仔","naam4 zai2"],["定係","ding6 hai6"],["女仔","neoi5 zai2"],["啊","aa3"],["？"]]},
      {"spk": "B", "en": "One boy, one girl. And do you have any brothers or sisters?", "parts": [["一個","jat1 go3"],["仔","zai2"],["，"],["一個","jat1 go3"],["女","neoi2"],["。"],["你","nei5"],["呢","ne1"],["？"],["有冇","jau5 mou5"],["兄弟姊妹","hing1 dai6 zi2 mui6"],["啊","aa3"],["？"]]},
