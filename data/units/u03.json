      {"spk": "B", "en": "It's fine. Oh, Ka-ming, good morning!", "parts": [["唔緊要","m4 gan2 jiu3"],["。"],["咦","ji2"],["，"],["家明","gaa1 ming4"],["，"],["早晨","zou2 san4"],["！"]]},
      {"spk": "A", "en": "Good morning, Mr Chan! How have you been?", "parts": [["陳生","can4 saang1"],["，"],["早晨","zou2 san4"],["！"],["最近","zeoi3 gan6"],["點","dim2"],["啊","aa3"],["？"]]},
      {"spk": "B", "en": "Pretty good, thanks. Where are you going?", "parts": [["幾好","gei2 hou2"],["，"],["多謝","do1 ze6"],["。"],["你","nei5"],["去","heoi3"],["邊度","bin1 dou6"],["啊","aa3"],["？"]]},
      {"spk": "A", "en": "I'm going running.", "parts": [["我","ngo5"],["去","heoi3"],["跑步","paau2 bou6"],["。"]]},
