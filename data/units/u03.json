{
  "id": "u03",
  "level": 1,
  "title": "Hello & Thanks",
  "emoji": "👋",
  "desc": "Greet people, say thanks and sorry, and answer yes or no",
  "words": [
    {"hk": "你好", "jp": "nei5 hou2", "en": "hello", "fr": "bonjour / salut",
     "note": "Fine with strangers. Friends often just say the person's name, or 早晨 in the morning.",
     "ex": {"en": "Hello, I'm Ka-ming.", "parts": [["你好","nei5 hou2"],["，"],["我","ngo5"],["叫","giu3"],["家明","gaa1 ming4"],["。"]]}},
    {"hk": "早晨", "jp": "zou2 san4", "en": "good morning", "fr": "bonjour (le matin)",
     "note": "Used until about 11 a.m. There is no common 'good afternoon' — just say 你好.",
     "ex": {"en": "Good morning, Mr Chan!", "parts": [["早晨","zou2 san4"],["，"],["陳生","can4 saang1"],["！"]]}},
    {"hk": "早唞", "jp": "zou2 tau2", "en": "good night", "fr": "bonne nuit",
     "note": "Literally 'rest early'. Said when going to bed or leaving late at night — not 'good evening'.",
     "ex": {"en": "Good night, little sister!", "parts": [["細妹","sai3 mui2"],["，"],["早唞","zou2 tau2"],["！"]]}},
    {"hk": "拜拜", "jp": "baai1 baai3", "en": "bye-bye", "fr": "salut / bye",
     "note": "From English 'bye-bye'; the most common goodbye in Hong Kong.",
     "ex": {"en": "Bye! See you on Monday!", "parts": [["拜拜","baai1 baai3"],["！"],["星期一","sing1 kei4 jat1"],["見","gin3"],["！"]]}},
    {"hk": "再見", "jp": "zoi3 gin3", "en": "goodbye", "fr": "au revoir",
     "note": "A bit more formal than 拜拜.",
     "ex": {"en": "Goodbye, Mr Chan.", "parts": [["陳生","can4 saang1"],["，"],["再見","zoi3 gin3"],["。"]]}},
    {"hk": "唔該", "jp": "m4 goi1", "en": "thanks (for a service); excuse me", "fr": "merci (pour un service) ; excusez-moi",
     "note": "Use it when someone does something for you, to call a waiter, or to get past people. 唔該晒 = thanks a lot.",
     "ex": {"en": "Excuse me, where's the toilet?", "parts": [["唔該","m4 goi1"],["，"],["洗手間","sai2 sau2 gaan1"],["喺","hai2"],["邊度","bin1 dou6"],["啊","aa3"],["？"]]}},
    {"hk": "多謝", "jp": "do1 ze6", "en": "thank you (for a gift / compliment)", "fr": "merci (pour un cadeau)",
     "note": "For gifts, compliments and invitations. 多謝晒 = thanks very much.",
     "ex": {"en": "Thank you for your present!", "parts": [["多謝","do1 ze6"],["你","nei5"],["份","fan6"],["禮物","lai5 mat6"],["啊","aa3"],["！"]]}},
    {"hk": "唔使唔該", "jp": "m4 sai2 m4 goi1", "en": "you're welcome (reply to 唔該)", "fr": "de rien (réponse à 唔該)",
     "note": "Literally 'no need to thank'. The reply to 多謝 is 唔使客氣 m4 sai2 haak3 hei3."},
    {"hk": "對唔住", "jp": "deoi3 m4 zyu6", "en": "sorry", "fr": "pardon / désolé",
     "note": "A real apology. For small things (interrupting, saying no) use 唔好意思.",
     "ex": {"en": "Sorry! Are you OK?", "parts": [["對唔住","deoi3 m4 zyu6"],["！"],["你","nei5"],["冇事","mou5 si6"],["吖嘛","aa1 maa3"],["？"]]}},
    {"hk": "唔好意思", "jp": "m4 hou2 ji3 si1", "en": "excuse me / sorry (light)", "fr": "excusez-moi / désolé (léger)",
     "ex": {"en": "Sorry, I can't go.", "parts": [["唔好意思","m4 hou2 ji3 si1"],["，"],["我","ngo5"],["唔可以","m4 ho2 ji5"],["去","heoi3"],["。"]]}},
    {"hk": "唔緊要", "jp": "m4 gan2 jiu3", "en": "never mind / it doesn't matter", "fr": "ce n'est pas grave",
     "ex": {"en": "Never mind, I'll walk home.", "parts": [["唔緊要","m4 gan2 jiu3"],["，"],["我","ngo5"],["行路","haang4 lou6"],["返","faan1"],["屋企","uk1 kei2"],["。"]]}},
    {"hk": "冇問題", "jp": "mou5 man6 tai4", "en": "no problem", "fr": "pas de problème",
     "ex": {"en": "No problem, go ahead and use it.", "parts": [["冇問題","mou5 man6 tai4"],["，"],["你","nei5"],["用","jung6"],["啦","laa1"],["。"]]}},
    {"hk": "係", "jp": "hai6", "en": "to be; yes", "fr": "être ; oui",
     "note": "Links two nouns (I am Ka-ming). Alone, 係啊 hai6 aa3 means 'yes, that's right'.",
     "ex": {"en": "I'm Ka-ming.", "parts": [["我","ngo5"],["係","hai6"],["家明","gaa1 ming4"],["。"]]}},
    {"hk": "唔係", "jp": "m4 hai6", "en": "is not; no", "fr": "ne pas être ; non",
     "ex": {"en": "No, I'm not Mr Chan.", "parts": [["唔係","m4 hai6"],["，"],["我","ngo5"],["唔係","m4 hai6"],["陳生","can4 saang1"],["。"]]}},
    {"hk": "好", "jp": "hou2", "en": "good; OK; very", "fr": "bien ; d'accord ; très",
     "note": "好 + adjective = very: 好甜 very sweet. 好啊！ = OK, sure!",
     "ex": {"en": "OK! Let's go!", "parts": [["好","hou2"],["啊","aa3"],["！"],["我哋","ngo5 dei6"],["去","heoi3"],["啦","laa1"],["！"]]}},
    {"hk": "你好嗎", "jp": "nei5 hou2 maa3", "en": "how are you?", "fr": "comment ça va ?",
     "note": "Textbook phrase. Hongkongers more often say 最近點啊？ or 你好唔好啊？"},
    {"hk": "最近點啊", "jp": "zeoi3 gan6 dim2 aa3", "en": "how have you been?", "fr": "comment ça va ces temps-ci ?",
     "note": "Literally 'lately how?'. The everyday 'how are you'.",
     "ex": {"en": "Mr Chan, how have you been?", "parts": [["陳生","can4 saang1"],["，"],["最近","zeoi3 gan6"],["點","dim2"],["啊","aa3"],["？"]]}},
    {"hk": "幾好", "jp": "gei2 hou2", "en": "pretty good / not bad", "fr": "plutôt bien",
     "note": "幾 before an adjective = 'quite'. 都幾好 = actually quite good.",
     "ex": {"en": "Not bad. And you?", "parts": [["幾好","gei2 hou2"],["啊","aa3"],["，"],["你","nei5"],["呢","ne1"],["？"]]}},
    {"hk": "叫", "jp": "giu3", "en": "to be called; to call", "fr": "s'appeler ; appeler",
     "ex": {"en": "My big brother is called Ka-ming.", "parts": [["我","ngo5"],["哥哥","go4 go1"],["叫","giu3"],["家明","gaa1 ming4"],["。"]]}},
    {"hk": "請問", "jp": "ceng2 man6", "en": "excuse me, may I ask…", "fr": "excusez-moi, puis-je demander…",
     "note": "Polite opener before a question to a stranger.",
     "ex": {"en": "Excuse me, are you Mr Chan?", "parts": [["請問","ceng2 man6"],["你","nei5"],["係唔係","hai6 m4 hai6"],["陳生","can4 saang1"],["啊","aa3"],["？"]]}},
    {"hk": "得", "jp": "dak1", "en": "OK / that works / can", "fr": "d'accord / ça marche / pouvoir",
     "note": "得唔得？ = Is that OK? Answer 得 (yes) or 唔得 (no).",
     "ex": {"en": "Sure, no problem!", "parts": [["得","dak1"],["，"],["冇問題","mou5 man6 tai4"],["！"]]}}
  ],
  "sentences": [
    {"en": "Good morning, Mr Chan! How have you been?", "parts": [["早晨","zou2 san4"],["，"],["陳生","can4 saang1"],["！"],["最近","zeoi3 gan6"],["點","dim2"],["啊","aa3"],["？"]]},
    {"en": "Pretty good, thanks.", "parts": [["幾好","gei2 hou2"],["啊","aa3"],["，"],["多謝","do1 ze6"],["。"]]},
    {"en": "Excuse me, are you Ka-ming?", "parts": [["唔好意思","m4 hou2 ji3 si1"],["，"],["你","nei5"],["係唔係","hai6 m4 hai6"],["家明","gaa1 ming4"],["啊","aa3"],["？"]]},
    {"en": "No, I'm his big brother.", "parts": [["唔係","m4 hai6"],["，"],["我","ngo5"],["係","hai6"],["佢","keoi5"],["哥哥","go4 go1"],["。"]]},
    {"en": "Sorry, I don't eat beef.", "parts": [["唔好意思","m4 hou2 ji3 si1"],["，"],["我","ngo5"],["唔","m4"],["食","sik6"],["牛肉","ngau4 juk6"],["。"]]},
    {"en": "Never mind, no problem!", "parts": [["唔緊要","m4 gan2 jiu3"],["，"],["冇問題","mou5 man6 tai4"],["！"]]},
    {"en": "Is Saturday OK for you?", "parts": [["你","nei5"],["星期六","sing1 kei4 luk6"],["得唔得","dak1 m4 dak1"],["啊","aa3"],["？"]]},
    {"en": "Good night! I'm going to sleep now.", "parts": [["早唞","zou2 tau2"],["！"],["我","ngo5"],["而家","ji4 gaa1"],["去","heoi3"],["瞓覺","fan3 gaau3"],["。"]]},
    {"en": "Bye-bye! See you on Sunday!", "parts": [["拜拜","baai1 baai3"],["！"],["星期日","sing1 kei4 jat6"],["見","gin3"],["！"]]},
    {"en": "Thank you! I really like it!", "parts": [["多謝","do1 ze6"],["！"],["我","ngo5"],["好","hou2"],["鍾意","zung1 ji3"],["啊","aa3"],["！"]]},
    {"en": "Excuse me, can I use the computer?", "parts": [["唔該","m4 goi1"],["，"],["我","ngo5"],["可唔可以","ho2 m4 ho2 ji5"],["用","jung6"],["部","bou6"],["電腦","din6 nou5"],["啊","aa3"],["？"]]},
    {"en": "Is your big sister well?", "parts": [["你","nei5"],["家姐","gaa1 ze1"],["好唔好","hou2 m4 hou2"],["啊","aa3"],["？"]]},
    {"en": "This isn't sweet, it's salty!", "parts": [["呢個","ni1 go3"],["唔係","m4 hai6"],["甜","tim4"],["嘅","ge3"],["，"],["係","hai6"],["鹹","haam4"],["嘅","ge3"],["！"]]}
  ],
  "grammar": [
    {"title": "唔該 or 多謝?",
     "explain": "唔該 thanks someone for doing something for you (a service, a small favour) and also means 'excuse me'. 多謝 thanks someone for a gift, a compliment or an invitation.",
     "examples": [
       {"en": "Excuse me, I'd like a glass of water.", "parts": [["唔該","m4 goi1"],["，"],["我","ngo5"],["想要","soeng2 jiu3"],["杯水","bui1 seoi2"],["。"]]},
       {"en": "Thanks for the present!", "parts": [["多謝","do1 ze6"],["你","nei5"],["份","fan6"],["禮物","lai5 mat6"],["！"]]}
     ]},
    {"title": "Yes/no questions: A-唔-A",
     "explain": "Repeat the verb with 唔 in the middle: 係唔係, 鍾唔鍾意. There's no single word for 'yes' or 'no' — answer with the verb (係 / 鍾意) or its negative (唔係 / 唔鍾意).",
     "examples": [
       {"en": "Are you Ka-ming?", "parts": [["你","nei5"],["係唔係","hai6 m4 hai6"],["家明","gaa1 ming4"],["啊","aa3"],["？"]]},
       {"en": "Yes, I'm Ka-ming.", "parts": [["係","hai6"],["啊","aa3"],["，"],["我","ngo5"],["係","hai6"],["家明","gaa1 ming4"],["。"]]},
       {"en": "Do you like fish? — No.", "parts": [["你","nei5"],["鍾唔鍾意","zung1 m4 zung1 ji3"],["食","sik6"],["魚","jyu2"],["啊","aa3"],["？"],["唔鍾意","m4 zung1 ji3"],["。"]]}
     ]},
    {"title": "好 = very",
     "explain": "Before an adjective, 好 means 'very' (好難, 好甜). On its own, 好 means 'good' or 'OK'.",
     "examples": [
       {"en": "You're so nice!", "parts": [["你","nei5"],["好","hou2"],["好人","hou2 jan4"],["啊","aa3"],["！"]]},
       {"en": "OK, no problem!", "parts": [["好","hou2"],["啊","aa3"],["，"],["冇問題","mou5 man6 tai4"],["！"]]}
     ]}
  ],
  "dialogue": {
    "title": "Bumping into a neighbour",
