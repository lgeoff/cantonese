      {"spk": "B", "en": "Haha, OK then, bye!", "parts": [["哈哈","haa1 haa1"],["，"],["噉","gam2"],["拜拜","baai1 baai3"],["啦","laa1"],["！"]]},
      {"spk": "A", "en": "Bye!", "parts": [["拜拜","baai1 baai3"],["！"]]}
    ],
    "questions": [
      {"q": "How has Mr Chan been?", "options": ["Pretty good", "Not well", "Very busy", "Tired"], "answer": 0},
      {"q": "Where is Ka-ming going?", "options": ["Running", "Home", "Shopping", "To bed"], "answer": 0},
      {"q": "What's the weather like?", "options": ["It's raining", "It's sunny", "It's snowing", "It's windy"], "answer": 0},
      {"q": "What time of day is it?", "options": ["Morning", "Afternoon", "Evening", "Late at night"], "answer": 0}
