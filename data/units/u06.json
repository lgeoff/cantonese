  "grammar": [
    {"title": "Time comes before the verb",
     "explain": "Put 'when' right after the subject (or at the very start), never at the end: 我聽日去 = I'm going tomorrow. Bigger units come first: 聽日朝早七點.",
     "examples": [
       {"en": "I'm going to Hong Kong tomorrow.", "parts": [["我","ngo5"],["聽日","ting1 jat6"],["去","heoi3"],["香港","hoeng1 gong2"],["。"]]},
       {"en": "Tomorrow morning at seven, I go running.", "parts": [["聽日","ting1 jat6"],["朝早","ziu1 zou2"],["七點","cat1 dim2"],["，"],["我","ngo5"],["去","heoi3"],["跑步","paau2 bou6"],["。"]]}
     ]},
    {"title": "Telling the time: 點, 半, 個字",
     "explain": "Hour + 點: 三點. Add 半 for half past: 三點半. Minutes are counted in 個字 (5-minute steps on the clock face): 三點三 = 3:15, 三點九 = 3:45. You can also say exact minutes with 分: 三點十分.",
     "examples": [
       {"en": "3:15", "parts": [["三點三","saam1 dim2 saam1"]]},
       {"en": "3:30", "parts": [["三點半","saam1 dim2 bun3"]]},
       {"en": "3:45", "parts": [["三點九","saam1 dim2 gau2"]]}
     ]},
    {"title": "Days of the week",
     "explain": "星期 or 禮拜 + number: 一 Monday … 六 Saturday. Sunday is 日 (not 七!): 星期日 / 禮拜日.",
     "examples": [
       {"en": "See you on Friday!", "parts": [["星期五","sing1 kei4 ng5"],["見","gin3"],["！"]]},
       {"en": "Are you free on Sunday?", "parts": [["你","nei5"],["禮拜日","lai5 baai3 jat6"],["有冇","jau5 mou5"],["時間","si4 gaan3"],["啊","aa3"],["？"]]}
     ]}
  ],
