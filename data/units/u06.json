    {"hk": "遲到", "jp": "ci4 dou3", "en": "to be late (for something)", "fr": "être en retard",
     "ex": {"en": "Sorry, I'm late!", "parts": [["對唔住","deoi3 m4 zyu6"],["，"],["我","ngo5"],["遲到","ci4 dou3"],["！"]]}},
    {"hk": "時間", "jp": "si4 gaan3", "en": "time", "fr": "temps",
