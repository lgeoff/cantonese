  "title": "Days & Time",
  "emoji": "🕒",
  "desc": "Tell the time, talk about today, tomorrow and yesterday, and make (or miss!) appointments",
  "words": [
    {"hk": "今日", "jp": "gam1 jat6", "en": "today", "fr": "aujourd'hui",
