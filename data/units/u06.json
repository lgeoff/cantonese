    {"hk": "月", "jp": "jyut6", "en": "month", "fr": "mois",
     "note": "Months are numbered: 一月 January … 十二月 December. 下個月 = next month.",
     "ex": {"en": "I'm going to France next month.", "parts": [["我","ngo5"],["下個月","haa6 go3 jyut6"],["去","heoi3"],["法國","faat3 gwok3"],["。"]]}},
    {"hk": "年", "jp": "nin4", "en": "year", "fr": "an / année",
     "note": "今年 this year, but 舊年 gau6 nin2 last year and 出年 ceot1 nin2 next year (tone change).",
