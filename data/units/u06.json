    {"hk": "點鐘", "jp": "dim2 zung1", "en": "o'clock", "fr": "heure(s)",
     "note": "In speech 鐘 is usually dropped: 三點 = three o'clock.",
     "ex": {"en": "It's three o'clock now.", "parts": [["而家","ji4 gaa1"],["三點鐘","saam1 dim2 zung1"],["。"]]}},
    {"hk": "半", "jp": "bun3", "en": "half", "fr": "demi(e)",
