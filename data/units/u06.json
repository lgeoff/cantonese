     "ex": {"en": "Where did you go yesterday?", "parts": [["你","nei5"],["尋日","cam4 jat6"],["去咗","heoi3 zo2"],["邊度","bin1 dou6"],["啊","aa3"],["？"]]}},
    {"hk": "後日", "jp": "hau6 jat6", "en": "the day after tomorrow", "fr": "après-demain",
     "note": "And 前日 cin4 jat6 = the day before yesterday.",
     "ex": {"en": "The day after tomorrow is my birthday.", "parts": [["後日","hau6 jat6"],["係","hai6"],["我","ngo5"],["生日","saang1 jat6"],["。"]]}},
    {"hk": "禮拜", "jp": "lai5 baai3", "en": "week (colloquial)", "fr": "semaine (familier)",
     "note": "Same as 星期 but more casual: 禮拜一 = Monday, 禮拜日 = Sunday.",
     "ex": {"en": "See you next week!", "parts": [["下個","haa6 go3"],["禮拜","lai5 baai3"],["見","gin3"],["！"]]}},
    {"hk": "幾點", "jp": "gei2 dim2", "en": "what time", "fr": "quelle heure",
