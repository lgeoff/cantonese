    {"hk": "今晚", "jp": "gam1 maan5", "en": "tonight", "fr": "ce soir",
     "ex": {"en": "What do you want to eat tonight?", "parts": [["今晚","gam1 maan5"],["你","nei5"],["想","soeng2"],["食","sik6"],["咩","me1"],["啊","aa3"],["？"]]}},
    {"hk": "早", "jp": "zou2", "en": "early", "fr": "tôt",
