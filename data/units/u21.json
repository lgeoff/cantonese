{
  "id": "u21",
  "level": 4,
  "title": "Advanced Patterns",
  "emoji": "🧩",
  "desc": "Link ideas like a native: passives, 'even', 'as soon as', 'the more… the more', 'even if', 'rather'",
  "words": [
    {"hk": "畀人", "jp": "bei2 jan4", "en": "(passive) by someone", "fr": "(passif) par quelqu'un", "note": "畀 + doer + verb: 畀人偷咗 = got stolen (by someone). Cantonese must name a doer; use 人 if unknown.", "ex": {"en": "My bike got stolen.", "parts": [["我", "ngo5"], ["部", "bou6"], ["單車", "daan1 ce1"], ["畀人", "bei2 jan4"], ["偷咗", "tau1 zo2"], ["。"]]}},
    {"hk": "將", "jp": "zoeng1", "en": "(object first) take X and…", "fr": "(objet en avant) prendre X et…", "note": "將 + object + verb + where: moves the object before the verb. Slightly formal; very common in instructions.", "ex": {"en": "Please take the rubbish downstairs.", "parts": [["唔該", "m4 goi1"], ["你", "nei5"], ["將", "zoeng1"], ["啲", "di1"], ["垃圾", "laap6 saap3"], ["拎", "ling1"], ["落", "lok6"], ["樓下", "lau4 haa6"], ["。"]]}},
    {"hk": "連…都", "jp": "lin4 dou1", "en": "even …", "fr": "même …", "note": "Put the surprising item between 連 and 都.", "ex": {"en": "He's so busy he doesn't even have time to eat.", "parts": [["佢", "keoi5"], ["忙", "mong4"], ["到", "dou3"], ["連", "lin4"], ["食飯", "sik6 faan6"], ["都", "dou1"], ["冇", "mou5"], ["時間", "si4 gaan3"], ["。"]]}},
    {"hk": "一…就", "jp": "jat1 zau6", "en": "as soon as …", "fr": "dès que …", "note": "一 + first action, 就 + second action.", "ex": {"en": "I go home as soon as I finish work.", "parts": [["我", "ngo5"], ["一", "jat1"], ["放工", "fong3 gung1"], ["就", "zau6"], ["返", "faan1"], ["屋企", "uk1 kei2"], ["。"]]}},
    {"hk": "越嚟越", "jp": "jyut6 lai4 jyut6", "en": "more and more", "fr": "de plus en plus", "note": "越嚟越 + adjective or 鍾意 etc.", "ex": {"en": "The weather is getting hotter and hotter.", "parts": [["天氣", "tin1 hei3"], ["越嚟越", "jyut6 lai4 jyut6"], ["熱", "jit6"], ["。"]]}},
    {"hk": "越…越", "jp": "jyut6 jyut6", "en": "the more … the more …", "fr": "plus … plus …", "note": "越 + verb, 越 + result.", "ex": {"en": "The more he talked, the angrier he got.", "parts": [["佢", "keoi5"], ["越", "jyut6"], ["講", "gong2"], ["越", "jyut6"], ["嬲", "nau1"], ["。"]]}},
    {"hk": "除咗…之外", "jp": "ceoi4 zo2 zi1 ngoi6", "en": "apart from …; besides …", "fr": "à part … ; en plus de …", "note": "Often followed by 仲 (also) or 都 (all).", "ex": {"en": "Besides Cantonese, he can also speak French.", "parts": [["除咗", "ceoi4 zo2"], ["廣東話", "gwong2 dung1 waa2"], ["之外", "zi1 ngoi6"], ["，"], ["佢", "keoi5"], ["仲", "zung6"], ["識", "sik1"], ["講", "gong2"], ["法文", "faat3 man2"], ["。"]]}},
    {"hk": "如果…就", "jp": "jyu4 gwo2 zau6", "en": "if … then …", "fr": "si … alors …", "note": "就 goes after the subject in the second clause.", "ex": {"en": "If it rains tomorrow, we won't go hiking.", "parts": [["如果", "jyu4 gwo2"], ["聽日", "ting1 jat6"], ["落雨", "lok6 jyu5"], ["，"], ["我哋", "ngo5 dei6"], ["就", "zau6"], ["唔", "m4"], ["去", "heoi3"], ["行山", "haang4 saan1"], ["喇", "laa3"], ["。"]]}},
    {"hk": "只要…就", "jp": "zi2 jiu3 zau6", "en": "as long as …", "fr": "du moment que …", "note": "A minimum condition that is enough.", "ex": {"en": "As long as you practise, you'll definitely learn it.", "parts": [["只要", "zi2 jiu3"], ["你", "nei5"], ["肯", "hang2"], ["練習", "lin6 zaap6"], ["，"], ["就", "zau6"], ["一定", "jat1 ding6"], ["學得識", "hok6 dak1 sik1"], ["。"]]}},
    {"hk": "就算…都", "jp": "zau6 syun3 dou1", "en": "even if …", "fr": "même si …", "note": "就算 + condition, (subject) 都 + result.", "ex": {"en": "Even if there's a typhoon tomorrow, I still have to work.", "parts": [["就算", "zau6 syun3"], ["聽日", "ting1 jat6"], ["打風", "daa2 fung1"], ["，"], ["我", "ngo5"], ["都", "dou1"], ["要", "jiu3"], ["返工", "faan1 gung1"], ["。"]]}},
    {"hk": "無論…都", "jp": "mou4 leon6 dou1", "en": "no matter …", "fr": "peu importe …", "note": "Usually with a question word: 無論幾貴 / 無論邊個.", "ex": {"en": "No matter how expensive, she wants to buy it.", "parts": [["無論", "mou4 leon6"], ["幾", "gei2"], ["貴", "gwai3"], ["，"], ["佢", "keoi5"], ["都", "dou1"], ["要", "jiu3"], ["買", "maai5"], ["。"]]}},
    {"hk": "寧願", "jp": "ning4 jyun6", "en": "would rather", "fr": "préférer (plutôt)", "note": "寧願 A，都唔 B = I'd rather A than B. Often said ning4 jyun2 in fast speech.", "ex": {"en": "I'd rather take the stairs than squeeze into the lift.", "parts": [["我", "ngo5"], ["寧願", "ning4 jyun6"], ["行樓梯", "haang4 lau4 tai1"], ["，"], ["都", "dou1"], ["唔想", "m4 soeng2"], ["逼𨋢", "bik1 lip1"], ["。"]]}},
    {"hk": "唔使", "jp": "m4 sai2", "en": "no need to; don't have to", "fr": "pas besoin de", "ex": {"en": "No need to wait for me, I'm working late tonight.", "parts": [["你", "nei5"], ["唔使", "m4 sai2"], ["等", "dang2"], ["我", "ngo5"], ["，"], ["我", "ngo5"], ["今晚", "gam1 maan5"], ["要", "jiu3"], ["加班", "gaa1 baan1"], ["。"]]}},
    {"hk": "一定要", "jp": "jat1 ding6 jiu3", "en": "must; have to", "fr": "il faut absolument", "ex": {"en": "When you come to Hong Kong you must try egg tarts.", "parts": [["你", "nei5"], ["嚟", "lai4"], ["香港", "hoeng1 gong2"], ["一定要", "jat1 ding6 jiu3"], ["試下", "si3 haa5"], ["蛋撻", "daan6 taat1"], ["。"]]}},
    {"hk": "到底", "jp": "dou3 dai2", "en": "(what) on earth; after all", "fr": "au juste ; enfin", "note": "Adds impatience to a question.", "ex": {"en": "What on earth do you want?", "parts": [["你", "nei5"], ["到底", "dou3 dai2"], ["想點", "soeng2 dim2"], ["啊", "aa3"], ["？"]]}},
    {"hk": "究竟", "jp": "gau3 ging2", "en": "(who/what) exactly", "fr": "au juste", "note": "Like 到底, a bit more neutral.", "ex": {"en": "Who exactly ate all the cake?", "parts": [["究竟", "gau3 ging2"], ["係", "hai6"], ["邊個", "bin1 go3"], ["食晒", "sik6 saai3"], ["啲", "di1"], ["蛋糕", "daan6 gou1"], ["？"]]}},
    {"hk": "反而", "jp": "faan2 ji4", "en": "instead; on the contrary", "fr": "au contraire", "note": "Result is the opposite of what you'd expect.", "ex": {"en": "He didn't get angry — instead he burst out laughing.", "parts": [["佢", "keoi5"], ["冇", "mou5"], ["嬲", "nau1"], ["，"], ["反而", "faan2 ji4"], ["笑咗", "siu3 zo2"], ["出嚟", "ceot1 lai4"], ["。"]]}},
    {"hk": "甚至", "jp": "sam6 zi3", "en": "even; to the point of", "fr": "voire ; même", "note": "Raises the stakes; a bit more formal than 連…都.", "ex": {"en": "He loves Japan so much he even taught himself Japanese.", "parts": [["佢", "keoi5"], ["好", "hou2"], ["鍾意", "zung1 ji3"], ["日本", "jat6 bun2"], ["，"], ["甚至", "sam6 zi3"], ["自己", "zi6 gei2"], ["學", "hok6"], ["埋", "maai4"], ["日文", "jat6 man2"], ["。"]]}},
    {"hk": "唔係嘅話", "jp": "m4 hai6 ge3 waa2", "en": "otherwise", "fr": "sinon", "ex": {"en": "Hurry up, otherwise we won't make it.", "parts": [["快啲", "faai3 di1"], ["走", "zau2"], ["啦", "laa1"], ["，"], ["唔係嘅話", "m4 hai6 ge3 waa2"], ["趕唔切", "gon2 m4 cit3"], ["。"]]}},
    {"hk": "先至", "jp": "sin1 zi3", "en": "only then", "fr": "seulement après", "note": "A 先至 B = only after A can B. Shorter: 先.", "ex": {"en": "Only after finishing your homework can you play video games.", "parts": [["做完", "zou6 jyun4"], ["功課", "gung1 fo3"], ["先至", "sin1 zi3"], ["可以", "ho2 ji5"], ["打機", "daa2 gei1"], ["。"]]}},
    {"hk": "淨係", "jp": "zing6 hai6", "en": "only; just", "fr": "seulement", "note": "Before a verb or noun.", "ex": {"en": "I only had a coffee, I haven't eaten.", "parts": [["我", "ngo5"], ["淨係", "zing6 hai6"], ["飲咗", "jam2 zo2"], ["杯", "bui1"], ["咖啡", "gaa3 fe1"], ["，"], ["冇", "mou5"], ["食", "sik6"], ["嘢", "je5"], ["。"]]}},
    {"hk": "起碼", "jp": "hei2 maa5", "en": "at least", "fr": "au moins", "ex": {"en": "Getting to the airport from here takes at least an hour.", "parts": [["由", "jau4"], ["呢度", "ni1 dou6"], ["去", "heoi3"], ["機場", "gei1 coeng4"], ["起碼", "hei2 maa5"], ["要", "jiu3"], ["一個鐘", "jat1 go3 zung1"], ["。"]]}}
  ],
  "sentences": [
    {"en": "My phone got stolen — I can't even get back the photos on it.", "parts": [["我", "ngo5"], ["部", "bou6"], ["手機", "sau2 gei1"], ["畀人", "bei2 jan4"], ["偷咗", "tau1 zo2"], ["，"], ["連", "lin4"], ["入面", "jap6 min6"], ["啲", "di1"], ["相", "soeng2"], ["都", "dou1"], ["搵唔返", "wan2 m4 faan1"], ["。"]]},
    {"en": "As soon as she heard the news she burst into tears.", "parts": [["佢", "keoi5"], ["一", "jat1"], ["聽到", "teng1 dou2"], ["呢個", "ni1 go3"], ["消息", "siu1 sik1"], ["就", "zau6"], ["喊咗", "haam3 zo2"], ["出嚟", "ceot1 lai4"], ["。"]]},
    {"en": "If you forgot your umbrella, just buy one at the convenience store.", "parts": [["如果", "jyu4 gwo2"], ["你", "nei5"], ["唔記得", "m4 gei3 dak1"], ["帶", "daai3"], ["遮", "ze1"], ["，"], ["就", "zau6"], ["喺", "hai2"], ["便利店", "bin6 lei6 dim3"], ["買", "maai5"], ["把", "baa2"], ["啦", "laa1"], ["。"]]},
    {"en": "Apart from Sunday, he has to work every day.", "parts": [["除咗", "ceoi4 zo2"], ["星期日", "sing1 kei4 jat6"], ["之外", "zi1 ngoi6"], ["，"], ["佢", "keoi5"], ["日日", "jat6 jat6"], ["都", "dou1"], ["要", "jiu3"], ["返工", "faan1 gung1"], ["。"]]},
    {"en": "Do you actually know what you did wrong or not?", "parts": [["你", "nei5"], ["到底", "dou3 dai2"], ["知唔知", "zi1 m4 zi1"], ["自己", "zi6 gei2"], ["做錯咗", "zou6 co3 zo2"], ["咩", "me1"], ["啊", "aa3"], ["？"]]},
    {"en": "I'd rather cook myself than eat takeaway every day.", "parts": [["我", "ngo5"], ["寧願", "ning4 jyun6"], ["自己", "zi6 gei2"], ["煮", "zyu2"], ["，"], ["都", "dou1"], ["唔想", "m4 soeng2"], ["日日", "jat6 jat6"], ["食", "sik6"], ["外賣", "ngoi6 maai6"], ["。"]]},
    {"en": "As long as it doesn't rain, we'll go for a beach barbecue tomorrow.", "parts": [["只要", "zi2 jiu3"], ["唔", "m4"], ["落雨", "lok6 jyu5"], ["，"], ["我哋", "ngo5 dei6"], ["聽日", "ting1 jat6"], ["就", "zau6"], ["去", "heoi3"], ["海邊", "hoi2 bin1"], ["燒烤", "siu1 haau1"], ["。"]]},
    {"en": "He likes Hong Kong more and more, and is even thinking of moving there.", "parts": [["佢", "keoi5"], ["越嚟越", "jyut6 lai4 jyut6"], ["鍾意", "zung1 ji3"], ["香港", "hoeng1 gong2"], ["，"], ["甚至", "sam6 zi3"], ["諗住", "nam2 zyu6"], ["搬", "bun1"], ["過去", "gwo3 heoi3"], ["住", "zyu6"], ["。"]]},
    {"en": "Even if you failed the exam, there's no need to be so upset.", "parts": [["就算", "zau6 syun3"], ["考試", "haau2 si5"], ["唔", "m4"], ["合格", "hap6 gaak3"], ["，"], ["都", "dou1"], ["唔使", "m4 sai2"], ["咁", "gam3"], ["唔開心", "m4 hoi1 sam1"], ["。"]]},
    {"en": "Please give this document to the boss — he needs to see it as soon as he's back.", "parts": [["唔該", "m4 goi1"], ["你", "nei5"], ["將", "zoeng1"], ["份", "fan6"], ["文件", "man4 gin2"], ["交", "gaau1"], ["畀", "bei2"], ["老闆", "lou5 baan2"], ["，"], ["佢", "keoi5"], ["一", "jat1"], ["返嚟", "faan1 lai4"], ["就", "zau6"], ["要", "jiu3"], ["睇", "tai2"], ["。"]]},
    {"en": "The older the kid gets, the more he looks like his dad.", "parts": [["個", "go3"], ["細路", "sai3 lou6"], ["越", "jyut6"], ["大", "daai6"], ["越", "jyut6"], ["似", "ci5"], ["佢", "keoi5"], ["爸爸", "baa4 baa1"], ["。"]]},
    {"en": "You're all talk — when exactly are you going to actually do it?", "parts": [["你", "nei5"], ["成日", "seng4 jat6"], ["淨係", "zing6 hai6"], ["識", "sik1"], ["講", "gong2"], ["，"], ["究竟", "gau3 ging2"], ["幾時", "gei2 si4"], ["先至", "sin1 zi3"], ["做", "zou6"], ["啊", "aa3"], ["？"]]},
    {"en": "No matter how busy he is, he calls home every week.", "parts": [["無論", "mou4 leon6"], ["幾", "gei2"], ["忙", "mong4"], ["，"], ["佢", "keoi5"], ["每個", "mui5 go3"], ["禮拜", "lai5 baai3"], ["都", "dou1"], ["會", "wui5"], ["打電話", "daa2 din6 waa2"], ["返", "faan1"], ["屋企", "uk1 kei2"], ["。"]]}
  ],
  "grammar": [
    {"title": "Passive with 畀", "explain": "Cantonese passive is 'thing + 畀 + doer + verb (+咗)'. Unlike English, the doer can't be dropped: if you don't know who, say 畀人. It's mostly used for unpleasant events.", "examples": [{"en": "I got told off by the boss.", "parts": [["我", "ngo5"], ["畀", "bei2"], ["老闆", "lou5 baan2"], ["鬧咗", "naau6 zo2"], ["一餐", "jat1 caan1"], ["。"]]}, {"en": "His wallet was stolen by someone.", "parts": [["佢", "keoi5"], ["個", "go3"], ["銀包", "ngan4 baau1"], ["畀人", "bei2 jan4"], ["偷咗", "tau1 zo2"], ["。"]]}, {"en": "The cake got eaten by my little brother.", "parts": [["個", "go3"], ["蛋糕", "daan6 gou1"], ["畀", "bei2"], ["我", "ngo5"], ["細佬", "sai3 lou2"], ["食晒", "sik6 saai3"], ["。"]]}]},
    {"title": "就 in the second half", "explain": "一…就 (as soon as), 如果…就 (if), 只要…就 (as long as) all put 就 right before the verb of the second clause — after its subject, never before it.", "examples": [{"en": "As soon as I get home I take a shower.", "parts": [["我", "ngo5"], ["一", "jat1"], ["返", "faan1"], ["屋企", "uk1 kei2"], ["就", "zau6"], ["沖涼", "cung1 loeng4"], ["。"]]}, {"en": "As long as you're happy, that's fine.", "parts": [["只要", "zi2 jiu3"], ["你", "nei5"], ["開心", "hoi1 sam1"], ["，"], ["就", "zau6"], ["得", "dak1"], ["喇", "laa3"], ["。"]]}]},
    {"title": "就算 / 無論 … 都", "explain": "Concessive clauses take 都 in the second half: 'even if X, (subject) still Y'. 寧願 A 都唔 B works the same way: 'rather A than B'.", "examples": [{"en": "Even if it rains, I'm still going.", "parts": [["就算", "zau6 syun3"], ["落雨", "lok6 jyu5"], ["，"], ["我", "ngo5"], ["都", "dou1"], ["去", "heoi3"], ["。"]]}, {"en": "No matter what you say, he won't listen.", "parts": [["無論", "mou4 leon6"], ["你", "nei5"], ["講", "gong2"], ["乜嘢", "mat1 je5"], ["，"], ["佢", "keoi5"], ["都", "dou1"], ["唔", "m4"], ["聽", "teng1"], ["。"]]}]}
  ],
  "dialogue": {
    "title": "The noisy neighbours",
    "lines": [
      {"spk": "A", "en": "Why do you look so tired today?", "parts": [["你", "nei5"], ["今日", "gam1 jat6"], ["做咩", "zou6 me1"], ["咁", "gam3"], ["攰", "gui6"], ["啊", "aa3"], ["？"]]},
      {"spk": "B", "en": "Sigh, I get woken up every morning by the renovation next door — not even Saturday is spared.", "parts": [["唉", "aai1"], ["，"], ["我", "ngo5"], ["朝朝", "ziu1 ziu1"], ["都", "dou1"], ["畀", "bei2"], ["隔籬屋", "gaak3 lei4 uk1"], ["裝修", "zong1 sau1"], ["嘈醒", "cou4 seng2"], ["，"], ["連", "lin4"], ["星期六", "sing1 kei4 luk6"], ["都", "dou1"], ["唔", "m4"], ["放過", "fong3 gwo3"], ["我", "ngo5"], ["。"]]},
      {"spk": "A", "en": "How long on earth do they still need?", "parts": [["佢哋", "keoi5 dei6"], ["到底", "dou3 dai2"], ["仲", "zung6"], ["要", "jiu3"], ["搞", "gaau2"], ["幾耐", "gei2 noi6"], ["啊", "aa3"], ["？"]]},
      {"spk": "B", "en": "They say at least two months. The more I think about it, the angrier I get.", "parts": [["佢哋", "keoi5 dei6"], ["話", "waa6"], ["起碼", "hei2 maa5"], ["要", "jiu3"], ["兩個月", "loeng5 go3 jyut6"], ["。"], ["我", "ngo5"], ["越", "jyut6"], ["諗", "nam2"], ["越", "jyut6"], ["嬲", "nau1"], ["。"]]},
      {"spk": "A", "en": "Have you complained to the management office?", "parts": [["你", "nei5"], ["有冇", "jau5 mou5"], ["同", "tung4"], ["管理處", "gun2 lei5 cyu3"], ["投訴", "tau4 sou3"], ["啊", "aa3"], ["？"]]},
      {"spk": "B", "en": "I have, but management says as long as they don't work at night, there's nothing they can do.", "parts": [["投訴咗", "tau4 sou3 zo2"], ["喇", "laa3"], ["，"], ["但係", "daan6 hai6"], ["管理處", "gun2 lei5 cyu3"], ["話", "waa6"], ["只要", "zi2 jiu3"], ["佢哋", "keoi5 dei6"], ["唔係", "m4 hai6"], ["夜晚", "je6 maan5"], ["開工", "hoi1 gung1"], ["，"], ["就", "zau6"], ["管唔到", "gun2 m4 dou2"], ["。"]]},
      {"spk": "A", "en": "Then why don't you come and stay at my place for a while? I've got a spare room.", "parts": [["噉", "gam2"], ["不如", "bat1 jyu4"], ["你", "nei5"], ["搬", "bun1"], ["嚟", "lai4"], ["我", "ngo5"], ["度", "dou6"], ["住", "zyu6"], ["一排", "jat1 paai4"], ["啦", "laa1"], ["，"], ["我", "ngo5"], ["屋企", "uk1 kei2"], ["有", "jau5"], ["間", "gaan1"], ["吉房", "gat1 fong2"], ["。"]]},
      {"spk": "B", "en": "Thanks, but I'd rather put up with it for two months than trouble you.", "parts": [["多謝", "do1 ze6"], ["你", "nei5"], ["，"], ["不過", "bat1 gwo3"], ["我", "ngo5"], ["寧願", "ning4 jyun6"], ["忍", "jan2"], ["兩個月", "loeng5 go3 jyut6"], ["，"], ["都", "dou1"], ["唔想", "m4 soeng2"], ["麻煩", "maa4 faan4"], ["你", "nei5"], ["。"]]},
      {"spk": "A", "en": "No need to be polite! Even if you stayed half a year, I wouldn't mind.", "parts": [["唔使", "m4 sai2"], ["客氣", "haak3 hei3"], ["！"], ["就算", "zau6 syun3"], ["你", "nei5"], ["住", "zyu6"], ["半年", "bun3 nin4"], ["，"], ["我", "ngo5"], ["都", "dou1"], ["唔", "m4"], ["介意", "gaai3 ji3"], ["。"]]},
      {"spk": "B", "en": "Really? Then besides paying the electricity, I can also cook and tidy up for you!", "parts": [["真係", "zan1 hai6"], ["？"], ["噉", "gam2"], ["除咗", "ceoi4 zo2"], ["夾", "gaap3"], ["電費", "din6 fai3"], ["之外", "zi1 ngoi6"], ["，"], ["我", "ngo5"], ["仲", "zung6"], ["可以", "ho2 ji5"], ["幫", "bong1"], ["你", "nei5"], ["煮飯", "zyu2 faan6"], ["執屋", "zap1 uk1"], ["！"]]},
