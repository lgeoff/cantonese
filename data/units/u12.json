  "grammar": [
    {"title": "Classifier + noun = 'the'",
     "explain": "Drop 呢/嗰 and a classifier alone in front of a noun means 'the (one we both know)': 部冷氣 = the air-con, 條鎖匙 = the key. English needs 'the' or 'my'; Cantonese just uses the classifier.",
     "examples": [
       {"en": "The washing machine is broken.", "parts": [["部","bou6"],["洗衣機","sai2 ji1 gei1"],["壞咗","waai6 zo2"],["。"]]},
       {"en": "Where's the key?", "parts": [["條","tiu4"],["鎖匙","so2 si4"],["喺","hai2"],["邊度","bin1 dou6"],["啊","aa3"],["？"]]},
       {"en": "My room is very messy.", "parts": [["我","ngo5"],["間","gaan1"],["房","fong2"],["好","hou2"],["亂","lyun6"],["。"]]}
     ]},
    {"title": "Choosing the classifier",
     "explain": "部 for machines, 張 for flat things, 架 for vehicles, 間 for rooms and buildings, 條 for long thin things (keys, trousers, fish). If you're unsure, 個 is the safe default.",
     "examples": [
       {"en": "I have a computer and a bike.", "parts": [["我","ngo5"],["有","jau5"],["部","bou6"],["電腦","din6 nou5"],["同","tung4"],["架","gaa3"],["單車","daan1 ce1"],["。"]]},
       {"en": "There are two beds in this room.", "parts": [["呢間","ni1 gaan1"],["房","fong2"],["有","jau5"],["兩張","loeng5 zoeng1"],["床","cong4"],["。"]]}
     ]},
    {"title": "開 and 閂: open/close, on/off",
     "explain": "The same verbs work for doors, windows and devices: 開 = open / switch on, 閂 = close / switch off.",
