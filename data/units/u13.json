  "grammar": [
    {"title": "Adjectives are verbs: no 'to be'",
     "explain": "Never put 係 before an adjective. Use 好 (very / just linking) instead: 我好攰 = I'm tired. Without 好 it sounds like a contrast.",
     "examples": [
       {"en": "I'm (very) tired.", "parts": [["我","ngo5"],["好","hou2"],["攰","gui6"],["。"]]},
       {"en": "The weather is nice today.", "parts": [["今日","gam1 jat6"],["天氣","tin1 hei3"],["好","hou2"],["好","hou2"],["。"]]}
     ]},
    {"title": "有啲 = a bit (for feelings)",
     "explain": "有啲 + adjective = 'a bit / rather', usually for something negative: 有啲凍, 有啲攰. 一啲都唔 + adjective = 'not at all'.",
     "examples": [
       {"en": "I'm a bit nervous.", "parts": [["我","ngo5"],["有啲","jau5 di1"],["緊張","gan2 zoeng1"],["。"]]},
       {"en": "This film isn't boring at all.", "parts": [["套","tou3"],["戲","hei3"],["一啲","jat1 di1"],["都","dou1"],["唔","m4"],["悶","mun6"],["。"]]}
     ]},
    {"title": "會 = will / likely to",
     "explain": "會 wui5 before a verb is used for predictions, especially about the weather: 會落雨 = it's going to rain. Ask with 會唔會 (often said wui6 m4 wui5).",
     "examples": [
       {"en": "It's going to rain tonight.", "parts": [["今晚","gam1 maan5"],["會","wui5"],["落雨","lok6 jyu5"],["。"]]},
       {"en": "Will it be cold tomorrow?", "parts": [["聽日","ting1 jat6"],["會唔會","wui6 m4 wui5"],["凍","dung3"],["啊","aa3"],["？"]]}
     ]}
  ],
  "dialogue": {
    "title": "Typhoon day!",
    "lines": [
      {"spk": "A", "en": "Hey, the No. 8 signal is up! No work today!", "parts": [["喂","wai3"],["，"],["掛咗","gwaa3 zo2"],["八號風球","baat3 hou6 fung1 kau4"],["喇","laa3"],["！"],["今日","gam1 jat6"],["唔使","m4 sai2"],["返工","faan1 gung1"],["！"]]},
      {"spk": "B", "en": "Yay! I'm so happy!", "parts": [["好嘢","hou2 je5"],["！"],["好","hou2"],["開心","hoi1 sam1"],["啊","aa3"],["！"]]},
      {"spk": "A", "en": "But the wind is really strong outside. Are you scared?", "parts": [["但係","daan6 hai6"],["出面","ceot1 min6"],["好","hou2"],["大風","daai6 fung1"],["，"],["你","nei5"],["驚唔驚","geng1 m4 geng1"],["啊","aa3"],["？"]]},
      {"spk": "B", "en": "A little. Have you closed the windows?", "parts": [["有少少","jau5 siu2 siu2"],["。"],["你","nei5"],["閂咗","saan1 zo2"],["啲","di1"],["窗","coeng1"],["未","mei6"],["啊","aa3"],["？"]]},
      {"spk": "A", "en": "All closed. Is there any food in the fridge?", "parts": [["閂晒","saan1 saai3"],["喇","laa3"],["。"],["雪櫃","syut3 gwai6"],["有冇","jau5 mou5"],["嘢食","je5 sik6"],["啊","aa3"],["？"]]},
      {"spk": "B", "en": "Only instant noodles… and two beers.", "parts": [["淨係","zing6 hai6"],["得","dak1"],["公仔麵","gung1 zai2 min6"],["，"],["同埋","tung4 maai4"],["兩罐","loeng5 gun3"],["啤酒","be1 zau2"],["。"]]},
      {"spk": "A", "en": "Good enough! Let's watch TV at home.", "parts": [["夠","gau3"],["喇","laa3"],["！"],["我哋","ngo5 dei6"],["喺","hai2"],["屋企","uk1 kei2"],["睇電視","tai2 din6 si6"],["啦","laa1"],["。"]]},
      {"spk": "B", "en": "Wait… the Observatory says it'll go down to No. 3 at two o'clock.", "parts": [["等等","dang2 dang2"],["，"],["天文台","tin1 man4 toi4"],["話","waa6"],["兩點","loeng5 dim2"],["改","goi2"],["三號","saam1 hou6"],["喎","wo3"],["。"]]},
      {"spk": "A", "en": "Oh no… so we still have to go to work in the afternoon?", "parts": [["唔係","m4 hai6"],["啩","gwaa3"],["，"],["噉","gam2"],["晏晝","aan3 zau3"],["仲","zung6"],["要","jiu3"],["返工","faan1 gung1"],["？"]]},
      {"spk": "B", "en": "Yep! How annoying!", "parts": [["係","hai6"],["囉","lo1"],["！"],["好","hou2"],["激氣","gik1 hei3"],["啊","aa3"],["！"]]}
    ],
