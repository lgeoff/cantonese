  "grammar": [
    {
      "title": "不如 (bat1 jyu4)…啦 (laa1) = how about…",
      "explain": "Start with 不如 (bat1 jyu4) and end with 啦 (laa1) to make a friendly suggestion. To accept: 好啊 (hou2 aa3) / 好主意 (hou2 zyu2 ji3); to decline politely: 唔得啊 (m4 dak1 aa3)，我約咗人 (ngo5 joek3 zo2 jan4).",
      "examples": [
        {
          "en": "How about meeting at the MTR station?",
          "parts": [
