  "grammar": [
    {"title": "Building numbers 11–99",
     "explain": "Just stack them: 十一 = 10+1, 二十 = 2×10, 二十五 = 25. In speech, 二十 + digit is usually shortened to 廿 jaa6: 廿五 = 25.",
     "examples": [
       {"en": "Eleven", "parts": [["十一","sap6 jat1"]]},
       {"en": "Thirty-eight dollars", "parts": [["三十八","saam1 sap6 baat3"],["蚊","man1"]]},
       {"en": "Twenty-five dollars (spoken)", "parts": [["廿五","jaa6 ng5"],["蚊","man1"]]}
     ]},
    {"title": "兩 vs 二",
     "explain": "'Two' of something (before a measure word like 個, 張, 蚊) is 兩. Inside bigger numbers and when counting, use 二: 十二個, 二十蚊.",
     "examples": [
       {"en": "Two people", "parts": [["兩個","loeng5 go3"],["人","jan4"]]},
       {"en": "Twelve people", "parts": [["十二個","sap6 ji6 go3"],["人","jan4"]]}
     ]},
    {"title": "Saying prices the HK way",
     "explain": "With cents, drop 蚊 and say 個: 個半 = $1.50, 三個二 = $3.20. With hundreds, drop the last zero: 百五 = 150, 三百二 = 320.",
     "examples": [
       {"en": "$1.50", "parts": [["個半","go3 bun3"]]},
       {"en": "$3.20", "parts": [["三個二","saam1 go3 ji6"]]},
       {"en": "$320", "parts": [["三百二","saam1 baak3 ji6"],["蚊","man1"]]}
     ]}
