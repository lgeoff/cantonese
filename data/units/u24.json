      {"spk": "A", "en": "Have you seen this news item? It says rents rose again last month.", "parts": [["你", "nei5"], ["睇咗", "tai2 zo2"], ["呢段", "ni1 dyun6"], ["新聞", "san1 man4"], ["未", "mei6"], ["啊", "aa3"], ["？"], ["話", "waa6"], ["上個月", "soeng6 go3 jyut6"], ["租金", "zou1 gam1"], ["又", "jau6"], ["升咗", "sing1 zo2"], ["。"]]},
